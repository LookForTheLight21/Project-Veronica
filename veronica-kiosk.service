[Unit]
Description=Project Veronica Kiosk Dashboard
After=network-online.target graphical.target
Wants=network-online.target graphical.target

[Service]
Type=simple
User=lookforthelight
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/lookforthelight/Project Veronica
ExecStartPre=/bin/sleep 5
ExecStart=/bin/bash "/home/lookforthelight/Project Veronica/launch_kiosk.sh"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical.target
