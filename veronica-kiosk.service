[Unit]
Description=Project Veronica Kiosk Dashboard
After=network.target graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
WorkingDirectory=/home/pi/Project Veronica
ExecStartPre=/bin/sleep 5
ExecStart=/bin/bash /home/pi/Project\ Veronica/launch_kiosk.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target

